# ==============================================================================
# TexForge Local Development Environment Variables
# ==============================================================================
# Copy this file to .env before starting the development environment:
#   cp .env.example .env

# PostgreSQL Container Configuration
POSTGRES_DB=texforge
POSTGRES_USER=texforge_user
POSTGRES_PASSWORD=texforge_password
POSTGRES_PORT=5432

# Spring Boot Datasource Configuration (Local JVM -> Containerized PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=texforge
DB_USERNAME=texforge_user
DB_PASSWORD=texforge_password
